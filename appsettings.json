{
  "ConnectionStrings": {
    "LivePlotDB": "Server={DB_SERVER},Database={DB_NAME};TrustServerCertificate=True;MultipleActiveResultSets=true"
  },
  "Jwt": {
    "Issuer": "LivePlotApi",
    "Audience": "LivePlotApi",
    "ExpirationInMinutes": 60
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
